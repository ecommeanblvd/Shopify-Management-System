# Postgres (Railway provides DATABASE_URL automatically when a Postgres plugin is attached)
# Format: postgres://<user>:<password>@<host>:5432/<database>
DATABASE_URL=

# Token encryption — generate with: openssl rand -hex 32
ENCRYPTION_KEY_V1=
ENCRYPTION_KEY_CURRENT=v1

# Shopify app (from Shopify Dev Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Read scopes for spec #1, plus write scopes for spec #2.
# Add new scopes here when adding write features; existing stores will need re-install.
SHOPIFY_SCOPES=read_shipping,read_checkout_branding,read_products,write_shipping,write_shop_settings,read_orders
SHOPIFY_APP_URL=http://localhost:3000
# Pinned Shopify API version — review/update quarterly per Shopify's release schedule
SHOPIFY_API_VERSION=2025-01

# Better-Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (better-auth socialProviders.google) — the only sign-in method.
# Create credentials in Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID (Web application). Authorized redirect URI must be:
#   <BETTER_AUTH_URL>/api/auth/callback/google
# e.g. http://localhost:3000/api/auth/callback/google (dev) and the Railway URL (prod).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Closed-invite bootstrap. Comma-separated emails that are ALWAYS allowed to sign
# in and are auto-assigned the admin role on first sign-in (even with no invite).
# Keep at least the owner's email here until another admin exists.
BOOTSTRAP_ADMIN_EMAILS=lmtiep@gmail.com

# MMP webhook inbound (brand confirmation callbacks from MMP → SMS)
MMP_WEBHOOK_SECRET=

# SMS → MMP outbound (brand production requests). MMP must expose a receiver
# that verifies the x-mean-signature HMAC with MMP_OUTBOUND_SECRET.
MMP_OUTBOUND_URL=
MMP_OUTBOUND_SECRET=

# Vercel Cron — shared secret used to authenticate scheduled cron invocations
# (e.g. weekly FedEx fuel-surcharge refresh at /api/cron/refresh-fuel).
# Vercel auto-includes `Authorization: Bearer ${CRON_SECRET}` on cron requests
# when this env var is set on the project. Generate with: openssl rand -hex 32
CRON_SECRET=
