# Postgres (Railway provides DATABASE_URL automatically when a Postgres plugin is attached)
# Format: postgres://<user>:<password>@<host>:5432/<database>
DATABASE_URL=

# Token encryption — generate with: openssl rand -hex 32
ENCRYPTION_KEY_V1=
ENCRYPTION_KEY_CURRENT=v1

# Shopify app (from Shopify Dev Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Read scopes for spec #1, plus write scopes for spec #2.
# Add new scopes here when adding write features; existing stores will need re-install.
# NOTE: write_fulfillments is required to push fulfillments+tracking to Shopify
# (sub-project F1). read_customers is required for Customer Account Builder — the
# extension session token carries the customer id (JWT `sub`) only when the app has
# read_customers. Existing stores MUST RE-INSTALL after adding a scope, otherwise the
# new capability is blocked (shipPack / customer-account data endpoints return errors).
SHOPIFY_SCOPES=read_shipping,read_checkout_branding,read_products,write_shipping,write_shop_settings,read_orders,write_fulfillments,read_customers
SHOPIFY_APP_URL=http://localhost:3000
# Pinned Shopify API version — review/update quarterly per Shopify's release schedule
SHOPIFY_API_VERSION=2025-01

# Better-Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (better-auth socialProviders.google) — the only sign-in method.
# Create credentials in Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID (Web application). Authorized redirect URI must be:
#   <BETTER_AUTH_URL>/api/auth/callback/google
# e.g. http://localhost:3000/api/auth/callback/google (dev) and the Railway URL (prod).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Closed-invite bootstrap. Comma-separated emails that are ALWAYS allowed to sign
# in and are auto-assigned the admin role on first sign-in (even with no invite).
# Keep at least the owner's email here until another admin exists.
BOOTSTRAP_ADMIN_EMAILS=lmtiep@gmail.com

# MMP webhook inbound (brand confirmation callbacks from MMP → SMS)
MMP_WEBHOOK_SECRET=

# SMS → MMP outbound (brand production requests). MMP exposes a receiver at
# POST /api/integration/brand-requests that verifies the x-mean-signature HMAC.
# Secret is DIRECTIONAL: MMP_OUTBOUND_SECRET must hold the SAME VALUE as the secret
# MMP uses to VERIFY inbound-from-SMS (MMP names it MEAN_WEBHOOK_SECRET) — this is a
# DIFFERENT secret from MMP_WEBHOOK_SECRET (the MMP→SMS product-webhook direction).
MMP_OUTBOUND_URL=
MMP_OUTBOUND_SECRET=

# SMS → MMP orders push (bản ghi đơn cho đơn có hàng brand). Receiver MMP:
# POST /api/integration/orders, body-only HMAC. Secret dùng chung MMP_OUTBOUND_SECRET.
MMP_ORDERS_URL=

# Vercel Cron — shared secret used to authenticate scheduled cron invocations
# (e.g. weekly FedEx fuel-surcharge refresh at /api/cron/refresh-fuel).
# Vercel auto-includes `Authorization: Bearer ${CRON_SECRET}` on cron requests
# when this env var is set on the project. Generate with: openssl rand -hex 32
CRON_SECRET=

# Object storage for receiving photos / QC evidence (vendor-neutral S3 API:
# Supabase Storage, Cloudflare R2, AWS S3, MinIO). See lib/storage/s3.ts.
# When unset, QC-pass still works; QC-fail (requires a photo) is blocked.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# FedEx REST API (OAuth2 client_credentials). Set on Railway — do NOT commit.
# API Key = client_id, Secret Key = client_secret (from FedEx Developer Portal).
# Account number is required for negotiated (contract) rates + label creation.
# Base: prod https://apis.fedex.com | sandbox https://apis-sandbox.fedex.com
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=
FEDEX_API_BASE=https://apis.fedex.com
